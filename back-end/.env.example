# Back-end environment variables
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is git-ignored; never commit real credentials.

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Secret used to sign and verify JSON Web Tokens (required)
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-me-with-a-long-random-string

# Port the Express server listens on (optional, defaults to 3000)
PORT=3000

# Host the Express server binds to (optional, defaults to 0.0.0.0)
HOST=0.0.0.0
